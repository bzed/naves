#
# The imagery sources Náves knows. Every entry was checked by hand against the service on 2026-11-06, see
# docs/research/2026-11-06-imagery-sources.md. A user file (`$XDG_CONFIG_HOME/naves/imagery-sources.toml`) can add
# entries or replace one by its id.
#
# coverage = [west, south, east, north] in degrees, left out for the whole world.
# native_m = metres per pixel of the source.
# attribution may hold {year}, which a fetch replaces with the year of the scene.

[[source]]
id = "sentinel2-scenes"
name = "Sentinel-2 scenes"
kind = "stac"
url = "https://earth-search.aws.element84.com/v1"
collection = "sentinel-2-c1-l2a"
asset = "visual"
asset_hosts = ["e84-earth-search-sentinel-data.s3.us-west-2.amazonaws.com"]
native_m = 10.0
licence = "Copernicus Sentinel data, free and open"
attribution = "Contains modified Copernicus Sentinel data {year}"
non_commercial = false
note = "single dates: Náves picks the clearest scenes of the last two summers"

