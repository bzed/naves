#!/usr/bin/make -f
# SPDX-FileCopyrightText: 2026 Bernd Zeimetz <bernd@bzed.de>
# SPDX-License-Identifier: AGPL-3.0-or-later

export CARGO_HOME = $(CURDIR)/debian/cargo-home
export CARGO_TARGET_DIR = $(CURDIR)/debian/cargo-target

%:
	dh $@

override_dh_auto_configure:
	@test -d vendor || { echo "vendor/ is missing: run 'cargo vendor vendor' first (make deb does)" >&2; exit 1; }
	mkdir -p $(CURDIR)/debian/cargo-home
	printf '[source.crates-io]\nreplace-with = "vendored-sources"\n[source.vendored-sources]\ndirectory = "$(CURDIR)/vendor"\n' > $(CURDIR)/debian/cargo-home/config.toml

override_dh_auto_build:
	cargo build --release --locked --offline -p naves
	$(CARGO_TARGET_DIR)/release/naves man | gzip -9n > debian/naves.1.gz

override_dh_auto_test:

override_dh_auto_install:
	install -D -m 0755 $(CARGO_TARGET_DIR)/release/naves debian/naves/usr/bin/naves
	install -D -m 0644 debian/naves.1.gz debian/naves/usr/share/man/man1/naves.1.gz

override_dh_auto_clean:
	rm -rf debian/cargo-home debian/cargo-target debian/naves.1.gz
